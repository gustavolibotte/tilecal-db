# Node declaration

All Equipments Have: {
  ...@equipments.base_equipment
}

...@equipments.3_in_1_board
...@equipments.passive_hv_divider
...@equipments.cooling_hoses
...@equipments.daughterboard
...@equipments.mainboard
...@equipments.module
...@equipments.phase1_super_drawer
...@equipments.pmt
...@equipments.pmt_block

Phase 1 Super Drawer.style.fill: red
3 in 1 Board.style.fill: red
HV Divider.style.fill: red
HV Divider.tooltip: The HV Divier model changes between phase 1 and phase 2

# Edge declaration

PMT -> PMT Block: 1 {class: connection}
PMT Block -> Phase 1 Super Drawer: X {
  class: connection
  style.stroke: red
}
3 in 1 Board -> PMT Block: 1 {
  class: connection
  style.stroke: red
}
HV Divider -> PMT Block: 1 {
  class: connection
  style.stroke: red
}
Daughterboard -> Phase 1 Super Drawer: X {class: connection}
Mainboard -> Phase 1 Super Drawer: X {class: connection}
Phase 1 Super Drawer -> Module: 1 {
  class: connection
  style.stroke: red
}
Cooling Hoses -> Phase 1 Super Drawer: X {class: connection}
