...@classes

direction: right

...@data_types.file

Equipment: {
    shape: class
    ID: ATLAS ID
    model: VX, prototype
    location: Current location
    status: Current status
    owner: CERN Institute
    serial: Manufacturer issued serial code
    comments: Any useful information
    extra_params: Equipment type dependent
}

Child Equipment: {
    shape: class
}

Parent Equipment: {
    shape: class
}

Equipments: {
    shape: class
}

File <> Equipment: Test files, plots, etc{class: connection}
Equipment -> Parent Equipment: Installed into {class: connection}
Equipment <- Child Equipment: Installed into{class: connection}
Equipment <> Equipments: Other relations {class: connection}
