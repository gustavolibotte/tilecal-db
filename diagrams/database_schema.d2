...@classes

direction: down

title: {
  label: MySQL Database Schema
  near: top-center
  shape: text
  style.font-size: 40
}

equipments: {
  shape: sql_table
  id: char(14) {constraint: primary_key}
  type_id: uint {constraint: [foreign_key; NN]}
  owner_id: uint {constraint: [foreign_key; NN]}
  location_id: uint {constraint: [foreign_key; NN]}
  status_id: uint {constraint: [foreign_key; NN]}
  serial: varchar(20)
  type_params: json {constraint: NN;}
  comments: text
  created_at: timestamp utc {constraint: [NN default now()]}
  updated_at: timestamp utc {constraint: [NN default now()]}
  deleted_at: timestamp utc
}

equipment_types: {
  shape: sql_table
  id: uint {constraint: primary_key}
  name: varchar(30) {constraint: [unique; NN]}
  in_detector: bool {constraint: [NN]}
  system: enum {constraint: NN}
  label_: varchar(50) {constraint: [unique; NN]}
  params: json {constraint: NN}
  description: text
  created_at: timestamp utc {constraint: [NN default now()]}
  updated_at: timestamp utc {constraint: [NN default now()]}
  deleted_at: timestamp utc
  tooltip: system enum possibilities are ('LB','LE','LO','LL','LC')
}

type_slots: {
  shape: sql_table
  id: uint {constraint: primary_key}
  name: varchar(30) {constraint: [NN]}
  parent_type_id: uint {constraint: [foreign_key; NN]}
  allowed_type_id: uint {constraint: [foreign_key; NN]}
}

parent_child_equips: {
  shape: sql_table
  id: uint {constraint: primary_key}
  parent_equip_id: char(14) {constraint: [foreign_key; NN]}
  child_equip_id: char(14) {constraint: [foreign_key; NN]}
  slot_id: uint {constraint: [foreign_key; NN]}
}

institutes: {
  shape: sql_table
  id: uint {constraint: primary_key}
  name: varchar(100) {constraint: [NN; unique]}
  mne: char(3) {constraint: [NN; unique]}
  num: char(3) {constraint: [NN; unique]}
  place: varchar(50) {constraint: [NN; unique]}
  country: varchar(30) {constraint: [NN; unique]}
  created_at: timestamp utc {constraint: [NN default now()]}
  updated_at: timestamp utc {constraint: [NN default now()]}
  deleted_at: timestamp utc
}

locations: {
  shape: sql_table
  id: uint {constraint: primary_key}
  name: varchar(100) {constraint: [NN; unique]}
  institute_id: uint {constraint: [foreign_key; NN]}
  description: varchar(280)
  created_at: timestamp utc {constraint: [NN default now()]}
  updated_at: timestamp utc {constraint: [NN default now()]}
  deleted_at: timestamp utc
}

statuses: {
  shape: sql_table
  id: uint {constraint: primary_key}
  name: varchar(30) {constraint: [NN; unique]}
  description: text {constraint: [NN; unique]}
  created_at: timestamp utc {constraint: [NN default now()]}
  updated_at: timestamp utc {constraint: [NN default now()]}
  deleted_at: timestamp utc
}

files: {
  shape: sql_table
  id: uint {constraint: primary_key}
  name: varchar(100) {constraint: [NN; unique]}
  mime: varchar(50) {constraint: [NN;]}
  filedata: mediumblob {constraint: [NN]}
  description: text {constraint: [NN]}
  created_at: timestamp utc {constraint: [NN default now()]}
  updated_at: timestamp utc {constraint: [NN default now()]}
  deleted_at: timestamp utc
}

equipments_to_files: {
  shape: sql_table
  id: uint {constraint: primary_key}
  equipment_id: char(14) {constraint: [foreign_key; NN]}
  file_id: uint {constraint: [foreign_key; NN]}
  created_at: timestamp utc {constraint: [NN default now()]}
  updated_at: timestamp utc {constraint: [NN default now()]}
  deleted_at: timestamp utc
}

hist: {
  shape: sql_table
  id: uint {constraint: primary_key}
  user: varchar(20) {constraint: NN}
  table: varchar(30) {constraint: NN}
  action: varchar(15) {constraint: NN}
  record_id: varchar(14)
  changes: json {constraint: NN}
  filedata: mediumblob
  created_at: timestamp utc {constraint: [NN default now()]}
  tooltip: \"record_id\" is a pseudo foreign key the reference is guaranteed by the application. \"action\" can be one of the following: ('insert', 'update' 'delete', 'restore')
}


equipments.type_id -- equipment_types.id: type_id > id {class: connection}
equipments.owner_id -- institutes.id: owner_id > id {class: connection}
equipments.status_id -- statuses.id: status_id > id {class: connection}
equipments.location_id -- locations.id: location_id > id {class: connection}
equipments.id -- equipments_to_files.equipment_id: id < equipment_id {class: connection}
files.id -- equipments_to_files.file_id: id < file_id {class: connection}
locations.institute_id -- institutes.id: institute_id > id {class: connection}
type_slots.parent_type_id -- equipment_types.id: parent_type_id > id {class: connection}
type_slots.allowed_type_id -- equipment_types.id: allowed_type_id > id {class: connection}
parent_child_equips.parent_equip_id -- equipments.id: parent_equip_id > id {class: connection}
parent_child_equips.child_equip_id -- equipments.id: child_equip_id - id {class: connection}


equipments.id -- hist.record_id: id < record_id {class: connection}
equipment_types.id -- hist.record_id: id < record_id {class: connection}
institutes.id -- hist.record_id: id < record_id {class: connection}
locations.id -- hist.record_id: id < record_id {class: connection}
statuses.id -- hist.record_id: id < record_id {class: connection}
files.id -- hist.record_id: id < record_id {class: connection}
equipments_to_files.id -- hist.record_id: id < record_id {class: connection}
type_slots.id -- hist.record_id: id < record_id {class: connection}
parent_child_equips.id -- hist.record_id: id < record_id {class: connection}
